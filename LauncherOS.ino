// ============================================================================
//  Screen-off (AMOLED -> just blank pixels, native sleep behaviour)
// ============================================================================
static void screen_off() {
    if (screenIsOff) return;
    screenIsOff = true;
    gfx->fillScreen(BLACK);
}
static void screen_on() {
    if (!screenIsOff) return;
    screenIsOff = false;
    lv_obj_invalidate(lv_scr_act());
}

// ============================================================================
//  Render pump
// ============================================================================
static void lvgl_pump() { lv_timer_handler(); }

// ============================================================================
//  SETUP
// ============================================================================
void setup() {
    USBSerial.begin(115200);
    USBSerial.println("\n=== LauncherOS (LVGL v8) ===");

    if (!gfx->begin()) USBSerial.println("gfx->begin() failed");
    gfx->fillScreen(BLACK);

    Wire.begin(IIC_SDA, IIC_SCL);
    while (FT3168->begin() == false) { USBSerial.println("FT3168 init fail"); delay(500); }
    FT3168->IIC_Write_Device_State(
        FT3168->Arduino_IIC_Touch::Device::TOUCH_POWER_MODE,
        FT3168->Arduino_IIC_Touch::Device_Mode::TOUCH_POWER_MONITOR);

    pmu_init();
    favs_load();

    // ---- LVGL v8 init ----
    lv_init();

    size_t bufPx = LCD_WIDTH * 60;        // 60-row partial buffer
    lvgl_buf = (lv_color_t *)heap_caps_malloc(bufPx * sizeof(lv_color_t),
                                              MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
    if (!lvgl_buf)
        lvgl_buf = (lv_color_t *)heap_caps_malloc(bufPx * sizeof(lv_color_t), MALLOC_CAP_8BIT);
    lv_disp_draw_buf_init(&draw_buf, lvgl_buf, NULL, bufPx);

    lv_disp_drv_init(&disp_drv);
    disp_drv.flush_cb     = my_disp_flush;
    disp_drv.rounder_cb   = rounder_event_cb;
    disp_drv.draw_buf     = &draw_buf;
    disp_drv.hor_res      = LCD_WIDTH;
    disp_drv.ver_res      = LCD_HEIGHT;
    lv_disp_drv_register(&disp_drv);

    lv_indev_drv_init(&indev_drv);
    indev_drv.type    = LV_INDEV_TYPE_POINTER;
    indev_drv.read_cb = my_touchpad_read;
    lv_indev_drv_register(&indev_drv);

    build_splash();
    splash_progress(10, "init display");

    splash_progress(25, "mounting SD");
    SD_MMC.setPins(SDMMC_CLK, SDMMC_CMD, SDMMC_DATA);
    bool sd_ok = SD_MMC.begin("/sdcard", true);
    if (sd_ok) {
        splash_progress(40, "wifi config");
        parse_wifi_config();
        splash_progress(55, "connecting wifi");
        wifi_connect_and_sync();
        splash_progress(75, "scanning apps");
        scan_apps();
        splash_progress(88, "scanning photos");
        scan_photos();
    } else {
        splash_progress(50, "SD mount failed");
        delay(800);
    }
    splash_progress(100, "ready");
    delay(350);

    build_main_ui();
    lastTouchMs = millis();
}

// ============================================================================
//  LOOP
// ============================================================================
void loop() {
    // LVGL v8 tick (delta-millis approach -- no LV_TICK_CUSTOM required)
    static uint32_t lastMs = 0;
    uint32_t now = millis();
    lv_tick_inc(now - lastMs);
    lastMs = now;

    lvgl_pump();

    // 1 s clock refresh
    static uint32_t tT = 0;
    if (now - tT > 1000) {
        tT = now;
        if (!screenIsOff) {
            update_face_time();
            lv_event_send(face_time, LV_EVENT_REFRESH, NULL);   // sync shadow
        }
    }
    // 3 s battery refresh
    static uint32_t tB = 0;
    if (now - tB > 3000) {
        tB = now;
        if (!screenIsOff) update_face_battery();
    }

    // Screen-off timeout
    if (!screenIsOff && (now - lastTouchMs > SCREEN_OFF_TIMEOUT_MS)) {
        screen_off();
    } else if (screenIsOff && FT3168->IIC_Interrupt_Flag) {
        lastTouchMs = now;
        screen_on();
    }

    delay(5);
}
