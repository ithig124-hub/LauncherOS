//  LauncherOS.ino   --   DualCore Watch launcher (LVGL 8.3 / 8.4)
//  ----------------------------------------------------------------------------
//  Permanent launcher firmware for the Waveshare ESP32-S3-Touch-AMOLED-2.06.
//  Lives in the `factory` partition.  Built against LVGL v8 (NOT v9).
//
//  Single file as requested.  Everything (pin map, splash, watch face,
//  selector, OTA loader) lives in this .ino.  Drop `partitions.csv`
//  next to it before flashing.
//
//  Required libraries (Arduino IDE):
//      - Arduino_GFX_Library             (Waveshare bundle)
//      - Arduino_DriveBus_Library        (Waveshare bundle)
//      - SensorLib  +  XPowersLib        (Waveshare bundle)
//      - LVGL  v8.3.x  /  8.4
//      - Preferences  (built-in)
//      - WiFi         (built-in)
//
//  Optional custom font:  see USE_CUSTOM_FONT below.
// ============================================================================

